# Copy to .env and fill in real values. Never commit .env itself.
DJANGO_SECRET_KEY=replace-me-with-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_CSRF_TRUSTED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# SQLite for local dev:  sqlite:///db.sqlite3
# Postgres in production: postgres://USER:PASSWORD@HOST:5432/DBNAME
DATABASE_URL=sqlite:///db.sqlite3

JWT_ACCESS_LIFETIME_MINUTES=60
JWT_REFRESH_LIFETIME_DAYS=14

FRONTEND_ORIGIN=http://127.0.0.1:5173

PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
HUBTEL_CLIENT_ID=
HUBTEL_CLIENT_SECRET=